@inherits LayoutComponentBase
@inject ApiClient Api
@inject I18n L
@inject NavigationManager Nav
@inject LiveUpdates Live
@inject IJSRuntime JS
@implements IDisposable

<div class="app-frame" data-testid="app-shell">
<header class="topbar">
    <button @ref="menuTrigger" type="button" class="menu-trigger" data-testid="menu-trigger" aria-label="@L["Menu"]" aria-expanded="@drawerOpen" aria-controls="main-drawer" @onclick="OpenDrawer">☰</button>
    <NavLink class="brand" href=""><span class="brand-mark small"><AppIcon Name="home" /></span><span>@L["AppName"]</span><small class="app-version" data-testid="app-version">@buildVersion</small></NavLink>
</header>
<aside class="navigation-panel desktop-navigation" data-testid="desktop-navigation" aria-label="@L["Menu"]">
    <header><h2>@L["Menu"]</h2></header>
    <MainNavigation Desktop />
</aside>
@if (drawerOpen)
{
    <div class="drawer-backdrop" data-testid="drawer-backdrop" @onclick="CloseDrawer"></div>
    <aside id="main-drawer" class="navigation-panel main-drawer open" data-testid="main-drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title" @onkeydown="DrawerKeyDown">
        <header><h2 id="drawer-title">@L["Menu"]</h2><button type="button" class="icon-btn" aria-label="@L["Close"]" @onclick="CloseDrawer">×</button></header>
        <MainNavigation />
    </aside>
}
<main class="content">@Body</main>
<FeedbackButton />
</div>

@code {
    private string buildVersion = "v?";
    private bool drawerOpen;
    private bool focusDrawerOnRender;
    private ElementReference menuTrigger;
    protected override async Task OnInitializedAsync()
    {
        Live.Changed += Refresh;
        Nav.LocationChanged += Navigated;
        try { buildVersion = (await Api.GetAsync<BuildVersionDto>("api/version"))?.Version ?? "v?"; }
        catch (HttpRequestException) { buildVersion = "v?"; }
        await Live.StartAsync();
    }
    private void OpenDrawer() { drawerOpen = true; focusDrawerOnRender = true; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusDrawerOnRender || !drawerOpen) return;
        focusDrawerOnRender = false;
        await JS.InvokeVoidAsync("hc.dialogOpen", "main-drawer");
    }
    private async Task CloseDrawer() { if (!drawerOpen) return; drawerOpen = false; await JS.InvokeVoidAsync("hc.dialogClose"); await menuTrigger.FocusAsync(); }
    private async Task DrawerKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") await CloseDrawer(); }
    private void Navigated(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => InvokeAsync(CloseDrawer);
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() { Live.Changed -= Refresh; Nav.LocationChanged -= Navigated; }
}
