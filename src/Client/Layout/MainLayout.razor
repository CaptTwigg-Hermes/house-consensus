@inherits LayoutComponentBase
@inject AuthState Auth
@inject I18n L
@inject NavigationManager Nav
@inject LiveUpdates Live
@implements IDisposable

<div class="app-frame" data-testid="app-shell">
<header class="topbar">
    <NavLink class="brand" href=""><span class="brand-mark small"><AppIcon Name="home" /></span><span>@L["AppName"]</span></NavLink>
    <div class="top-actions">
        <NavLink class="profile-link" href="profile" data-testid="profile-nav" aria-label="@L["Profile"]">
            <span class="avatar" style="--avatar-color: @ProfileColor; background-color: var(--avatar-color)">@ProfileInitials</span>
            <span class="user-email" data-testid="current-user-email">@ProfileName</span>
        </NavLink>
        <span class="live-pill @(Live.Connected ? "online" : "")"><i></i>@L["Live"]</span>
        <select class="language" data-testid="language-select" aria-label="@L["Language"]" value="@Auth.User?.Language" @onchange="LanguageChanged">
            <option value="en">EN</option><option value="da">DA</option>
        </select>
        <button class="icon-btn" title="@L["SignOut"]" aria-label="@L["SignOut"]" @onclick="Logout"><AppIcon Name="logout" /></button>
    </div>
</header>
<div class="body-grid">
<nav class="side-nav" aria-label="@L["Menu"]">
    <NavLink href="" Match="NavLinkMatch.All"><AppIcon Name="home" />@L["Queue"]</NavLink>
    <NavLink href="browse"><AppIcon Name="search" />@L["Browse"]</NavLink>
    <NavLink href="everyone-likes"><AppIcon Name="heart" />@L["EveryoneLikes"]</NavLink>
    <NavLink href="my-votes"><AppIcon Name="check" />@L["MyVotes"]</NavLink>
    <NavLink href="household-votes"><AppIcon Name="members" />@L["HouseholdVotes"]</NavLink>
    <NavLink href="profile"><AppIcon Name="profile" />@L["Profile"]</NavLink>
    @if (Auth.IsOwner)
    {
        <div class="nav-section">@L["Owner"]</div>
        <NavLink href="owner/review"><AppIcon Name="review" />@L["Review"]</NavLink>
        <NavLink href="owner/feedback"><AppIcon Name="spark" />@L["Feedback"]</NavLink>
        <NavLink href="owner/members"><AppIcon Name="members" />@L["Members"]</NavLink>
    }
</nav>
<main class="content">@Body</main>
</div>
<nav class="bottom-nav" aria-label="@L["Menu"]">
    <NavLink href="" Match="NavLinkMatch.All"><AppIcon Name="home" /><small>@L["Queue"]</small></NavLink>
    <NavLink href="browse"><AppIcon Name="search" /><small>@L["Browse"]</small></NavLink>
    <NavLink href="everyone-likes"><AppIcon Name="heart" /><small>@L["EveryoneLikes"]</small></NavLink>
    <NavLink href="household-votes"><AppIcon Name="members" /><small>@L["HouseholdVotesShort"]</small></NavLink>
    @if (Auth.IsOwner) { <NavLink href="owner/review"><AppIcon Name="review" /><small>@L["Review"]</small></NavLink> }
</nav>
<FeedbackButton />
</div>

@code {
    protected override async Task OnInitializedAsync() { Live.Changed += Refresh; await Live.StartAsync(); }
    private string ProfileName => string.IsNullOrWhiteSpace(Auth.User?.DisplayName) ? Auth.User?.Email.Split('@')[0] ?? "" : Auth.User.DisplayName;
    private string ProfileInitials => AvatarInitials.From(Auth.User?.DisplayName ?? "", Auth.User?.Email ?? "");
    private string ProfileColor => AvatarColor.Resolve(Auth.User?.AvatarColor, Auth.User?.Id ?? Guid.Empty);
    private async Task LanguageChanged(ChangeEventArgs e) => await Auth.SetLanguageAsync(e.Value?.ToString() ?? "en");
    private async Task Logout() { await Auth.LogoutAsync(); Nav.NavigateTo("", true); }
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Live.Changed -= Refresh;
}
