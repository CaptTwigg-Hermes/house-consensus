@inject I18n L
@inject AuthState Auth
<article class="listing-card @(Listing.Consensus ? "consensus-card" : "")" data-testid="listing-card" data-listing-id="@Listing.Id" data-price="@Listing.Price">
    @if (Listing.ScoreStatus == ScoreStatus.Complete)
    {
        <button type="button" class="score-chip" aria-describedby="@TooltipId" aria-label="@($"{L["FamilyFit"]}: {Math.Round(Listing.FamilyFitScore!.Value)} {L["OutOf100"]}")">
            <strong>@Math.Round(Listing.FamilyFitScore!.Value)</strong><small>/100</small>
            <span id="@TooltipId" class="score-tooltip" role="tooltip">
                <span class="score-tooltip-heading"><span>@L["Dimension"]</span><span>@L["Score"]</span><span>@L["Contribution"]</span></span>
                @ScoreRow(L["Privacy"], Listing.FamilyPrivacyScore!.Value, Listing.FamilyPrivacyWeight!.Value)
                @ScoreRow(L["KidsSpace"], Listing.KidsSpaceScore!.Value, Listing.KidsSpaceWeight!.Value)
                @ScoreRow(L["Garden"], Listing.GardenScore!.Value, Listing.GardenWeight!.Value)
                @ScoreRow(L["SharedLiving"], Listing.SharedLivingScore!.Value, Listing.SharedLivingWeight!.Value)
                @ScoreRow(L["Practical"], Listing.PracticalScore!.Value, Listing.PracticalWeight!.Value)
                <span class="score-tooltip-total"><span>@L["Total"]</span><span>@Listing.FamilyFitScore.Value.ToString("0.#")</span></span>
            </span>
        </button>
    }
    else if (Listing.ScoreStatus == ScoreStatus.Incomplete)
    {
        <span class="score-chip unscored" aria-label="@L["ScoreIncomplete"]">— @L["ScoreIncomplete"]</span>
    }
    else if (Listing.ScoreStatus == ScoreStatus.NeedsReview)
    {
        <span class="score-chip unscored needs-review" aria-label="@L["ScoreNeedsReview"]">— @L["ScoreNeedsReview"]</span>
    }
    else if (Listing.ScoreStatus == ScoreStatus.NotScored)
    {
        <span class="score-chip unscored" aria-label="@L["ScoreNotScored"]">— @L["ScoreNotScored"]</span>
    }
    <NavLink class="card-main" href="@($"listing/{Listing.Id}")" aria-label="@($"{Listing.Address}, {Price}")">
        <div class="card-image">
            @if (!string.IsNullOrWhiteSpace(Listing.PreviewImageUrl))
            {
                <img src="@($"/api/listings/{Listing.Id}/image")" alt="@($"{L["PhotoOf"]} {Listing.Address}")" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
            }
            <div class="image-placeholder" aria-hidden="true"><span>⌂</span></div>
            <div class="card-image-shade"></div>
            <div class="image-badges">
                @if (IsRecentlyNew) { <span class="badge new">@L["New"]</span> }
                @if (Listing.IsManuallyAdded) { <span class="badge manual">@L["Manual"]</span> }
                @if (Listing.Consensus) { <span class="badge consensus">♥ @L["ConsensusShort"]</span> }
                @if (Listing.Quiet is true) { <span class="badge quiet">@L["Quiet"]</span> }
                @if (Listing.Floors == 1) { <span class="badge neutral">@L["OneFloor"]</span> }
            </div>
            <div class="card-image-meta">
                <div class="card-image-address"><h2>@Listing.Address</h2><p>@Listing.City</p></div>
                <div class="card-image-price"><strong>@Price</strong>@if (PricePerArea is not null) { <small>@PricePerArea</small> }</div>
            </div>
        </div>
        <div class="card-body">
            <PropertyFacts Listing="Listing" />
            <NoiseLevels Listing="Listing" />
            <CommuteTable Json="@Listing.CommuteJson" Compact="true" />
            @if (HasFitSignals)
            {
                <div class="fit-signals" aria-label="@L["FamilyFitSignals"]">
                    @if (Listing.SeparateEntrance is true) { <span>@L["SeparateEntrance"]</span> }
                    @if (Listing.SecondKitchen is true) { <span>@L["SecondKitchen"]</span> }
                    @if (Listing.GroundFloorBedroom is true) { <span>@L["GroundFloorBedroom"]</span> }
                    @if (Listing.PrivacyScore.HasValue) { <span>@L["Privacy"] @Listing.PrivacyScore/5</span> }
                    @if (Listing.BuildableHeadroom > 0) { <span>+@Listing.BuildableHeadroom m² @L["Buildable"]</span> }
                </div>
            }
            <footer class="card-footer">
                <span class="vote-dots" aria-label="@L["Everyone"]">@foreach (var vote in Listing.Votes) { <i class="@(vote.Choice == VoteChoice.Like ? "like" : "dislike")" style="@VoteStyle(vote)" title="@L.Enum(vote.Choice)"><span class="vote-symbol">@(vote.Choice == VoteChoice.Like ? "♥" : "×")</span></i> }</span>
            </footer>
        </div>
    </NavLink>
    <div class="card-external"><ExternalListingLink Url="@Listing.SourceUrl" /></div>
    @if (ShowVoting) { <VoteButtons ListingId="Listing.Id" Latest="@LatestOwnVote" OnVoted="OnVoted" /> }
</article>
@code {
    [Parameter, EditorRequired] public ListingDto Listing { get; set; } = default!;
    [Parameter] public bool ShowVoting { get; set; }
    [Parameter] public EventCallback OnVoted { get; set; }
    private VoteDto? LatestOwnVote => Listing.Votes.Where(x => x.MemberId == Auth.User?.Id).OrderByDescending(x => x.CreatedAt).ThenByDescending(x => x.Id).FirstOrDefault();
    private bool IsRecentlyNew => Listing.FirstSeenAt is { } firstSeen
        && firstSeen <= DateTimeOffset.UtcNow
        && firstSeen > DateTimeOffset.UtcNow.AddHours(-120);
    private string Price => Listing.Price.HasValue ? $"{Listing.Price.Value:N0} kr." : L["PriceOnRequest"];
    private string? PricePerArea => Listing.Price.HasValue && Listing.LivingArea > 0 ? $"{Listing.Price.Value / Listing.LivingArea.Value:N0} kr/m²" : null;
    private bool HasFitSignals => Listing.SeparateEntrance is true || Listing.SecondKitchen is true || Listing.GroundFloorBedroom is true || Listing.PrivacyScore.HasValue || Listing.BuildableHeadroom > 0;
    private bool HasScoreBreakdown => Listing.FamilyPrivacyScore.HasValue && Listing.KidsSpaceScore.HasValue && Listing.GardenScore.HasValue && Listing.SharedLivingScore.HasValue && Listing.PracticalScore.HasValue && Listing.FamilyPrivacyWeight.HasValue && Listing.KidsSpaceWeight.HasValue && Listing.GardenWeight.HasValue && Listing.SharedLivingWeight.HasValue && Listing.PracticalWeight.HasValue;
    private string TooltipId => $"score-tooltip-{Listing.Id:N}";
    private static string? VoteStyle(VoteDto vote) => vote.Choice == VoteChoice.Like
        ? $"--avatar-color: {AvatarColor.Resolve(vote.MemberColor, vote.MemberId)}; background-color: var(--avatar-color)"
        : null;
    private static RenderFragment ScoreRow(string label, double score, double weight) => builder =>
    {
        builder.OpenElement(0, "span"); builder.AddAttribute(1, "class", "score-tooltip-row");
        builder.OpenElement(2, "span"); builder.AddContent(3, $"{label} ({weight:0.#}%)"); builder.CloseElement();
        builder.OpenElement(4, "span"); builder.AddContent(5, $"{score:0}/100"); builder.CloseElement();
        builder.OpenElement(6, "span"); builder.AddContent(7, $"{score * weight / 100:0.0}"); builder.CloseElement();
        builder.CloseElement();
    };
}
