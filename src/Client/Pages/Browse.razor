@page "/browse"
@inject ApiClient Api
@inject I18n L
@inject IJSRuntime JS
@inject LiveUpdates Live
@implements IDisposable
<PageTitle>@L["Browse"] · @L["AppName"]</PageTitle>
<header class="page-head browse-head"><div><p class="eyebrow">@L["Browse"]</p><h1>@L["Browse"]</h1><p>@L["BrowseIntro"]</p></div>@if (allItems is not null) { <span class="count">@Visible.Count</span> }</header>
<section class="browse-toolbar" aria-label="@L["Filters"]">
    <form class="browse-search" @onsubmit="ApplySearch" @onsubmit:preventDefault><span aria-hidden="true">⌕</span><input placeholder="@L["SearchHomes"]" @bind="applied.Search" /><button type="submit" class="search-submit">@L["Search"]</button></form>
    <div class="toolbar-actions"><div class="view-toggle compact" role="group"><button type="button" data-testid="mobile-list-toggle" aria-label="@L["List"]" class="@(view == "list" ? "active" : "")" @onclick="ShowList">☷ <span>@L["List"]</span></button><button type="button" data-testid="mobile-map-toggle" aria-label="@L["Map"]" class="@(view == "map" ? "active" : "")" @onclick="ShowMap">⌖ <span>@L["Map"]</span></button></div><button type="button" data-testid="filter-open" class="filter-open" @onclick="OpenFilters">@L["Filters"]@if (applied.ActiveCount > 0) { <b>@applied.ActiveCount</b> }</button></div>
</section>
@if (filtersOpen)
{
    <div class="filter-backdrop open" @onclick="CloseFilters"><ListingFilterDrawer State="draft" Items="allItems!" PreviewCount="@draft.Apply(allItems!).Count" OnApply="ApplyFilters" OnClear="ClearFilters" OnClose="CloseFilters" /></div>
}
@if (allItems is null) { <Loading /> }
else if (Visible.Count == 0) { <EmptyState Title="@L["NoResults"]" Body="" /> }
else if (view == "list") { <section class="card-grid">@foreach (var item in Visible) { <ListingCard @key="item.Id" Listing="item" /> }</section> }
else { <div id="browse-map" data-testid="browse-map" class="map" aria-label="@L["Map"]"></div><p class="map-note">@L["MapNote"]</p> }
@code {
    private const string StateKey = "hc.filters.browse";
    private List<ListingDto>? allItems;
    private ListingFilterState applied = new(), draft = new();
    private string view = "list";
    private bool filtersOpen, stateLoaded;
    private IReadOnlyList<ListingDto> Visible => allItems is null ? [] : applied.Apply(allItems);
    protected override async Task OnInitializedAsync()
    {
        Live.Changed += LiveChanged;
        await Live.StartAsync();
        await Reload();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || stateLoaded) return;
        stateLoaded = true;
        applied = await JS.InvokeAsync<ListingFilterState?>("hc.loadState", StateKey) ?? new();
        draft = applied.Clone();
        StateHasChanged();
    }
    private void OpenFilters() { draft = applied.Clone(); filtersOpen = true; }
    private void CloseFilters() => filtersOpen = false;
    private async Task ApplyFilters() { applied = draft.Clone(); filtersOpen = false; await SaveAndRender(); }
    private async Task ClearFilters() { draft = new(); applied = new(); await SaveAndRender(); }
    private Task ApplySearch() => SaveAndRender();
    private async Task SaveAndRender() { await JS.InvokeVoidAsync("hc.saveState", StateKey, applied); if (view == "map") await RenderMap(); }
    private Task ShowList() { view = "list"; return Task.CompletedTask; }
    private async Task ShowMap() { view = "map"; await Task.Delay(1); await RenderMap(); }
    private async Task RenderMap() => await JS.InvokeVoidAsync("hc.renderMap", "browse-map", Visible.Where(x => x.Latitude.HasValue && x.Longitude.HasValue).Select(x => new { x.Id, x.Address, x.City, x.Latitude, x.Longitude, title = x.Address, price = x.Price, score = x.FamilyFitScore, image = $"/api/listings/{x.Id}/image", url = $"listing/{x.Id}" }));
    private async Task Reload() => allItems = await Api.GetAsync<List<ListingDto>>("api/listings/browse") ?? [];
    private void LiveChanged() => _ = InvokeAsync(async () => { await Reload(); StateHasChanged(); if (view == "map") { await Task.Delay(1); await RenderMap(); } });
    public void Dispose() => Live.Changed -= LiveChanged;
}
