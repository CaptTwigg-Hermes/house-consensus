@page "/owner/members"
@inject ApiClient Api
@inject I18n L
<PageTitle>@L["Members"] · @L["AppName"]</PageTitle>
<OwnerOnly>
<header class="page-head"><div><p class="eyebrow">@L["Owner"]</p><h1>@L["Members"]</h1><p>@L["MembersIntro"]</p></div></header>
@if (items is null) { <Loading /> } else
{
    <section class="member-list">@foreach (var member in items) { <article data-testid="member-row"><span class="avatar large" style="--avatar-color: @AvatarColor.Resolve(member.AvatarColor, member.Id); background-color: var(--avatar-color)">@Initials(member)</span><div><h2>@(string.IsNullOrWhiteSpace(member.DisplayName) ? member.Email.Split('@')[0] : member.DisplayName)</h2><p>@member.Email</p><span data-testid="member-status" class="badge @(member.IsActive ? "active" : "neutral")">@L[member.IsActive ? "Active" : "Inactive"]</span> <span data-testid="member-role" class="badge neutral">@L.Enum(member.Role)</span> <small>@member.Language.ToUpperInvariant()</small></div></article> }</section>
}
</OwnerOnly>
@code {
    private List<MemberDto>? items;
    protected override async Task OnInitializedAsync() => items = await Api.GetAsync<List<MemberDto>>("api/members") ?? [];
    private static string Initials(MemberDto m) => AvatarInitials.From(m.DisplayName, m.Email);
}
