@page "/owner/feedback"
@inject ApiClient Api
@inject I18n L
<PageTitle>@L["Feedback"] · @L["AppName"]</PageTitle>
<OwnerOnly>
<header class="page-head"><div><p class="eyebrow">@L["Owner"]</p><h1>@L["Feedback"]</h1><p>@L["FeedbackIntro"]</p></div><div class="export-actions"><a class="btn ghost" href="api/feedback/export.csv" download>↓ @L["ExportCsv"]</a><a class="btn ghost" href="api/feedback/export.json" download>↓ @L["ExportJson"]</a></div></header>
@if (items is null) { <Loading /> } else if (items.Count == 0) { <EmptyState Title="@L["NoFeedback"]" Body="@L["FeedbackIntro"]" /> } else
{
    <section class="feedback-list">@foreach (var item in items) { <article class="feedback-item @(item.ReviewedAt.HasValue ? "reviewed" : "")"><div class="feedback-status">@(item.ReviewedAt.HasValue ? "✓" : "•")</div><div><p>@item.Body</p><small>@item.CreatedAt.ToLocalTime().ToString("g") @if (item.ListingId.HasValue) { <NavLink href="@($"listing/{item.ListingId}")"> · @L["Details"]</NavLink> }</small></div><button class="btn ghost" @onclick="() => Toggle(item)">@(item.ReviewedAt.HasValue ? L["Unreview"] : L["MarkReviewed"])</button></article> }</section>
}
</OwnerOnly>
@code { private List<FeedbackDto>? items; protected override async Task OnInitializedAsync() => await Load(); private async Task Load() => items = await Api.GetAsync<List<FeedbackDto>>("api/feedback") ?? []; private async Task Toggle(FeedbackDto item) { using var r = await Api.ReviewFeedback(item.Id, !item.ReviewedAt.HasValue); await ApiClient.EnsureSuccess(r); await Load(); } }
