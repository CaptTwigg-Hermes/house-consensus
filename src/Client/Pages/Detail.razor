@page "/listing/{Id:guid}"
@inject ApiClient Api
@inject AuthState Auth
@inject I18n L
@inject LiveUpdates Live
@inject NavigationManager Nav
@implements IDisposable
<PageTitle>@(listing?.Address ?? L["Details"]) · @L["AppName"]</PageTitle>
@if (listing is null) { <Loading /> } else
{
    <NavLink class="back-link" href="browse">← @L["Browse"]</NavLink>
    @if (!string.IsNullOrWhiteSpace(listing.PreviewImageUrl))
    {
        <div class="detail-cover"><img src="@listing.PreviewImageUrl" alt="@($"{L["PhotoOf"]} {listing.Address}")" referrerpolicy="no-referrer" /></div>
    }
    <header class="detail-hero"><div><p class="eyebrow">@listing.City</p><h1>@listing.Address</h1><p class="detail-price">@(listing.Price?.ToString("N0") ?? L["PriceOnRequest"]) @(listing.Price.HasValue ? "kr." : "")</p>@if (listing.IsManuallyAdded) { <p class="manual-provenance"><span class="badge neutral">@L["ManuallyAdded"]</span> @L["AddedBy"] @listing.ManuallyAddedByName · @listing.ManuallyAddedAt?.ToLocalTime().ToString("d")</p> }</div><div class="hero-score"><strong>@(listing.FamilyFitScore.HasValue ? Math.Round(listing.FamilyFitScore.Value) : L["Unscored"])</strong>@if (listing.FamilyFitScore.HasValue) { <span>@L["FamilyFit"]</span> }</div></header>
    <PropertyFacts Listing="listing" />
    <NoiseLevels Listing="listing" />
    <CommuteTable Json="@listing.CommuteJson" />
    <div class="fit-signals detail-signals">
        @if (listing.Quiet is true) { <span>@L["Quiet"]</span> }
        @if (listing.SeparateEntrance is true) { <span>@L["SeparateEntrance"]</span> }
        @if (listing.SecondKitchen is true) { <span>@L["SecondKitchen"]</span> }
        @if (listing.GroundFloorBedroom is true) { <span>@L["GroundFloorBedroom"]</span> }
        @if (listing.PrivacyScore.HasValue) { <span>@L["Privacy"] @listing.PrivacyScore/5</span> }
        @if (listing.BuildableHeadroom > 0) { <span>+@listing.BuildableHeadroom m² @L["Buildable"]</span> }
    </div>
    @if (listing.Consensus) { <div class="consensus-banner" data-testid="match-banner">♥ <strong>@L["Consensus"]</strong></div> }
    <section class="detail-grid">
        <article class="panel"><h2>@L["Everyone"]</h2><p data-testid="unanimity-status">@(listing.Consensus ? L["Consensus"] : L["WaitingForVotes"])</p>@if (listing.Votes.Count == 0) { <p class="muted">@L["NoVotes"]</p> } else { <div class="household-votes">@foreach (var vote in listing.Votes) { <div><span class="avatar" style="--avatar-color: @AvatarColor.Resolve(vote.MemberColor, vote.MemberId); background-color: var(--avatar-color)">@vote.MemberInitials</span><strong>@L.Enum(vote.Choice)</strong><span class="choice @vote.Choice.ToString().ToLowerInvariant()">@(vote.Choice == VoteChoice.Like ? "♥" : vote.Choice == VoteChoice.Dislike ? "×" : "—")</span>@if (vote.Ratings?.Count > 0) { <small class="vote-rating-summary">@string.Join(" · ", vote.Ratings.Where(x => x.Rating != CategoryRating.Neutral).Select(x => $"{L.Enum(x.Category)}: {L.Enum(x.Rating)}"))</small> } else if (vote.Tags.Length > 0) { <small>@string.Join(" · ", vote.Tags.Select(tag => L.Enum(tag)))</small> }@if (!string.IsNullOrWhiteSpace(vote.Note)) { <p class="vote-note-excerpt">“@vote.Note”</p> }@if (vote.MemberId == Auth.User?.Id) { @if (editingVoteNote) { <div class="detail-edit-vote-note"><textarea data-testid="detail-edit-note" maxlength="2000" rows="3" @bind="editVoteNote"></textarea><div class="vote-actions"><button type="button" class="btn primary" @onclick="SaveVoteNote">@L["Save"]</button><button type="button" class="btn ghost" @onclick="CancelVoteNoteEdit">@L["Cancel"]</button></div></div> } else { <button type="button" data-testid="detail-edit-note-open" class="text-btn" @onclick="() => StartVoteNoteEdit(vote)">@L["EditNote"]</button> } }</div> }</div> }<VoteButtons ListingId="Id" Latest="@LatestOwnVote" OnVoted="Load" />@if (listing.IsManuallyAdded && (listing.CanWithdraw || listing.CanArchive)) { <button type="button" class="btn ghost danger" @onclick="Withdraw">@(listing.CanArchive ? L["ArchiveListing"] : L["Withdraw"])</button> }</article>
        <article class="panel"><h2>@L["Evidence"]</h2>@if (!listing.AiAssessed) { <span class="badge neutral">@L["NotAssessed"]</span> } else { <AiEvidencePanel Evidence="@listing.AiEvidence" Confidence="@listing.AiConfidence" ModelVersion="@listing.ModelVersion" /> }<ExternalListingLink Url="@listing.SourceUrl" />
        @if (Auth.IsOwner) { <div class="owner-override"><input maxlength="500" aria-label="@L["Reason"]" placeholder="@L["Reason"]" @bind="overrideReason" /><div class="vote-actions"><button class="btn like" @onclick="() => Override(OverrideAction.Restore)">↺ @L["Restore"]</button><button class="btn dislike" @onclick="() => Override(OverrideAction.Reject)">× @L["Reject"]</button></div></div> }</article>
    </section>
}
@code {
    [Parameter] public Guid Id { get; set; } private ListingDto? listing; private string overrideReason = ""; private IDisposable? liveSubscription; private bool editingVoteNote; private string editVoteNote = "";
    protected override async Task OnInitializedAsync() { await Live.WatchAsync(Id); liveSubscription = Live.OnListingChanged(LiveChanged); await Load(); }
    private VoteDto? LatestOwnVote => listing?.Votes.Where(x => x.MemberId == Auth.User?.Id).OrderByDescending(x => x.CreatedAt).ThenByDescending(x => x.Id).FirstOrDefault();
    private async Task Load() => listing = await Api.GetAsync<ListingDto>($"api/listings/{Id}");
    private async Task Withdraw() { using var response = await Api.WithdrawListing(Id); await ApiClient.EnsureSuccess(response); Nav.NavigateTo("browse"); }
    private void LiveChanged() => InvokeAsync(async () => { await Load(); StateHasChanged(); });
    private async Task Override(OverrideAction action) { using var r = await Api.Override(Id, action, overrideReason); await ApiClient.EnsureSuccess(r); overrideReason = ""; await Load(); }
    private void StartVoteNoteEdit(VoteDto vote) { editingVoteNote = true; editVoteNote = vote.Note ?? ""; }
    private void CancelVoteNoteEdit() { editingVoteNote = false; editVoteNote = ""; }
    private async Task SaveVoteNote() { using var response = await Api.EditVoteNote(Id, editVoteNote); await ApiClient.EnsureSuccess(response); CancelVoteNoteEdit(); await Load(); }
    public void Dispose() => liveSubscription?.Dispose();
}
