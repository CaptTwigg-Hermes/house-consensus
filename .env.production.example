# Existing Cloudflare Access application. These are identifiers, not tokens.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUDIENCE=

# Required deployment settings. Store real values only in Dockge/environment secrets.
POSTGRES_PASSWORD=
INITIAL_OWNER_EMAIL=owner@example.com
PUBLIC_ORIGIN=https://house.example.com

# Keep loopback unless the existing TrueNAS tunnel connector reaches this host port.
APP_BIND_IP=127.0.0.1
APP_PORT=8080